# The bench on a made-up session with a known answer: the reference solve has to find the simulation's mount and time offset.
execute_process(COMMAND ${BENCH} simulate ${WORK}/simulated.screc --duration 240 --seed 3 RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "simulate failed")
endif()
execute_process(COMMAND ${BENCH} reference ${WORK}/simulated.screc RESULT_VARIABLE result OUTPUT_VARIABLE output)
message("${output}")
if(NOT result EQUAL 0)
    message(FATAL_ERROR "reference failed")
endif()
string(REGEX MATCH "found within ([0-9.]+) deg and ([0-9.]+) mm" found "${output}")
if(NOT found)
    message(FATAL_ERROR "the reference did not report the simulation's mount")
endif()
if(CMAKE_MATCH_1 GREATER 0.05 OR CMAKE_MATCH_2 GREATER 1.0)
    message(FATAL_ERROR "the mount is off by ${CMAKE_MATCH_1} deg and ${CMAKE_MATCH_2} mm: more than 0.05 deg or 1 mm")
endif()
string(REGEX MATCH "target's poses are ([0-9.-]+) ms behind" found "${output}")
if(NOT found OR CMAKE_MATCH_1 LESS 11.0 OR CMAKE_MATCH_1 GREATER 13.0)
    message(FATAL_ERROR "the time offset is ${CMAKE_MATCH_1} ms where the simulation has 12")
endif()
file(REMOVE ${WORK}/simulated.screc)
